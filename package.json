{
  "name": "inkwell-blog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Auntilz · 古典淡雅的中文博客（Astro 静态站，支持 Obsidian 双链 / callout / 知识图谱、LaTeX、Mermaid 与全文批注）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "new": "node scripts/new-post.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "build": "node scripts/fetch-fonts.mjs && astro build && pagefind --site dist",
    "preview": "astro preview",
    "shot": "node scripts/shot.mjs",
    "qa": "node scripts/qa.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.4",
    "katex": "^0.19.1",
    "mermaid": "^12.2.0",
    "pagefind": "^1.5.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "puppeteer-core": "^25.16.0"
  }
}

