---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import Seal from '../components/Seal.astro';
import Icon from '../components/Icon.astro';

const all = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featured = all.filter((p) => p.data.featured).slice(0, 2);
const showcase = featured.length >= 2 ? featured : all.slice(0, 2);
const showcaseIds = new Set(showcase.map((p) => p.id));
const recent = all.filter((p) => !showcaseIds.has(p.id)).slice(0, 5);

const tagCounts = new Map<string, number>();
for (const post of all) {
  for (const tag of post.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const topTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12);
const firstYear = all.length ? Math.min(...all.map((p) => p.data.pubDate.getFullYear())) : new Date().getFullYear();
---

<BaseLayout>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="hero-eyebrow">私人书房 · 卷之壹</p>
        <h1 class="hero-title">字里行间<br />墨迹未干<span class="ink-dot"></span></h1>
        <p class="hero-lead">
          这里存放读书的札记、敲下的代码，和一些<em>尚未成篇</em>的念头。以宣纸为底，墨色为字，留给愿意慢下来的人。
        </p>
        <p class="hero-stats">
          <span>凡 {all.length} 篇</span>
          <span class="divider-dot" aria-hidden="true"></span>
          <span>自 {firstYear} 年起</span>
          <span class="divider-dot" aria-hidden="true"></span>
          <span>{tagCounts.size} 个标签</span>
        </p>
      </div>

      <blockquote class="hero-quote">
        「行到水穷处，<br />坐看云起时。」
        <cite>王维 · 终南别业</cite>
      </blockquote>
    </div>

    <div class="hero-bg ink-wash ink-wash--mountains" aria-hidden="true"></div>
    <Seal class="hero-seal" char="痕" />
  </section>

  <div class="wrap">
    <section class="section" aria-labelledby="sec-featured">
      <div class="section-head">
        <h2 class="section-title" id="sec-featured">
          精选
          <span class="section-index">01</span>
        </h2>
        <a class="section-more" href="/posts">
          全部文章
          <Icon name="arrow-right" size={13} class="icon" />
        </a>
      </div>

      {
        showcase.length > 0 ? (
          <div class="featured-grid">
            {showcase.map((post, i) => (
              <FeaturedCard post={post} index={i} />
            ))}
          </div>
        ) : (
          <p class="empty-state">书房还是空的，写下一篇之后，这里就会热闹起来。</p>
        )
      }
    </section>

    <div class="rule-cloud" aria-hidden="true"></div>

    {recent.length > 0 && (
      <section class="section" aria-labelledby="sec-recent">
        <div class="section-head">
          <h2 class="section-title" id="sec-recent">
            近作
            <span class="section-index">02</span>
          </h2>
          <a class="section-more" href="/archive">
            按时间翻
            <Icon name="arrow-right" size={13} class="icon" />
          </a>
        </div>

        <ol class="post-list" role="list">
          {recent.map((post, i) => <PostRow post={post} index={i} />)}
        </ol>
      </section>
    )}

    <div class="rule-cloud" aria-hidden="true"></div>

    <section class="section section--tags" aria-labelledby="sec-tags">
      <div class="section-head">
        <h2 class="section-title" id="sec-tags">
          笺注
          <span class="section-index">03</span>
        </h2>
        <a class="section-more" href="/tags">
          全部标签
          <Icon name="arrow-right" size={13} class="icon" />
        </a>
      </div>

      <ul class="tag-cloud" role="list">
        {
          topTags.map(([tag, count]) => (
            <li>
              <a class="tag-chip" href={`/tags/${encodeURIComponent(tag)}`}>
                <span>{tag}</span>
                <span class="tag-count">{count}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
