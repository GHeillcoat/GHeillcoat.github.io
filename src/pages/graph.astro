---
import BaseLayout from '../layouts/BaseLayout.astro';
import GraphCanvas from '../components/GraphCanvas.astro';
import { getSiteGraph } from '../lib/site-graph';

const graph = await getSiteGraph();
const ranked = [...graph.nodes].sort((a, b) => b.degree - a.degree || a.title.localeCompare(b.title, 'zh'));
const linked = graph.nodes.filter((node) => node.degree > 0).length;
---

<BaseLayout title="图谱" description="文章之间的双链关系：一张可拖动的知识图谱">
  <section class="page">
    <div class="wrap">
      <header class="page-head">
        <p class="page-eyebrow">双链</p>
        <h1 class="page-title">知识图谱</h1>
        <p class="page-desc">
          {graph.nodes.length} 篇笔记，{graph.edges.length} 条双链；其中 {linked} 篇已经连成一张网。
          拖动平移、滚轮缩放，点一个节点就进入那篇。
        </p>
      </header>

      <div class="graph-layout">
        <GraphCanvas graph={graph} mode="global" height={620} />

        <aside class="graph-side">
          <div class="graph-legend">
            <span class="graph-legend-item"><i class="graph-legend-dot"></i>笔记</span>
            <span class="graph-legend-item"><i class="graph-legend-line"></i>双链</span>
            <span class="graph-legend-item graph-legend-note">节点越大，链接越多</span>
          </div>

          <div class="graph-index">
            <h2 class="graph-index-title">
              全部笔记
              <span class="graph-index-count">{ranked.length}</span>
            </h2>
            <ol class="graph-index-list" role="list">
              {
                ranked.map((node) => (
                  <li>
                    <a href={node.url} class="graph-index-link">
                      <span class="graph-index-name">{node.title}</span>
                      <span class="graph-index-degree">{node.degree}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </div>
        </aside>
      </div>

      <p class="graph-foot">
        在任意文章里写 <code>[[另一篇的标题]]</code> 就会连出一条线；也可以写
        <code>[[标题|显示的文字]]</code> 或 <code>[[标题#小节]]</code>。
      </p>
    </div>
  </section>
</BaseLayout>
