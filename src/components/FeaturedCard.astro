---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { excerptFromBody, formatDateZh, isoDate, readingLabel } from '../lib/format';

export interface Props {
  post: CollectionEntry<'posts'>;
  index?: number;
}

const { post, index = 0 } = Astro.props;
const { data } = post;
const cover = typeof data.cover === 'string' ? data.cover : undefined;
const summary = data.description || excerptFromBody(post.body, 110);
---

<article class="featured-card" data-reveal style={`--reveal-delay:${index * 80}ms`}>
  {
    cover ? (
      <a class="post-cover" href={`/posts/${post.id}`} tabindex="-1" aria-hidden="true">
        <img src={cover} alt="" loading="lazy" decoding="async" />
      </a>
    ) : (
      <a class="post-cover post-cover--auto" href={`/posts/${post.id}`} tabindex="-1" aria-hidden="true">
        <span class="post-cover-glyph" aria-hidden="true">{data.category.slice(0, 1)}</span>
      </a>
    )
  }

  <span class="featured-kicker">
    <Icon name="spark" size={12} />
    {data.category}
  </span>

  <h3 class="featured-title">
    <a href={`/posts/${post.id}`}>{data.title}</a>
  </h3>

  {summary && <p class="featured-desc">{summary}</p>}

  <div class="featured-foot">
    <time datetime={isoDate(data.pubDate)}>{formatDateZh(data.pubDate)}</time>
    <span>{readingLabel(post.body ?? '', data.lang)}</span>
  </div>
</article>
