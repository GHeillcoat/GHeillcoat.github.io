---
import { site } from '../config';
import Icon from './Icon.astro';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const target = href.replace(/\/+$/, '') || '/';
  if (target === '/') return path === '/';
  if (target === '/posts') return path === '/posts' || path.startsWith('/posts/');
  return path === target || path.startsWith(`${target}/`);
};
---

<header class="site-header" data-site-header>
  <div class="header-inner">
    <a class="brand" href="/" aria-label={`${site.title} · 首页`}>
      <span class="brand-mark" aria-hidden="true">墨</span>
      <span class="brand-word">
        <span class="brand-name">{site.title}</span>
        <span class="brand-latin">{site.latin}</span>
      </span>
    </a>

    <nav class="site-nav" data-site-nav aria-label="主导航">
      {
        site.nav.map((item) => (
          <a
            class="nav-link"
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-tools">
      <button class="tool-btn" type="button" data-palette-open aria-label="打开搜索">
        <Icon name="search" class="icon" size={16} />
        <span class="tool-label">寻章</span>
        <span class="kbd-hint"><kbd>Ctrl</kbd><kbd>K</kbd></span>
      </button>

      <button
        class="tool-btn tool-btn--icon-only"
        type="button"
        data-theme-toggle
        aria-label="切换明暗"
        title="切换明暗"
      >
        <Icon name="moon" class="icon icon-moon" size={17} />
        <Icon name="sun" class="icon icon-sun" size={17} />
      </button>

      <button
        class="tool-btn tool-btn--icon-only menu-toggle"
        type="button"
        data-menu-toggle
        aria-label="菜单"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <Icon name="menu" class="icon" size={18} />
      </button>
    </div>
  </div>

  <div class="scroll-progress" data-progress aria-hidden="true"><span></span></div>
</header>
