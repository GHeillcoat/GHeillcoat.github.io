---
import Icon from './Icon.astro';
---

<div class="palette" data-palette hidden>
  <div class="palette-backdrop" data-palette-close aria-hidden="true"></div>
  <div
    class="palette-dialog"
    role="dialog"
    aria-modal="true"
    aria-label="站内搜索"
    aria-describedby="palette-hint"
  >
    <div class="palette-search">
      <Icon name="search" class="icon" size={17} />
      <input
        class="palette-input"
        data-palette-input
        type="text"
        placeholder="寻章摘句……"
        autocomplete="off"
        spellcheck="false"
        aria-label="搜索关键词"
        aria-controls="palette-results"
      />
      <kbd class="esc">ESC</kbd>
    </div>

    <div class="palette-results" data-palette-results id="palette-results" role="listbox" aria-label="搜索结果">
      <p class="palette-group" data-palette-group>常用</p>
    </div>

    <div class="palette-foot" id="palette-hint">
      <span><span class="k">↑↓</span>选择</span>
      <span><span class="k">↵</span>打开</span>
      <span><span class="k">esc</span>关闭</span>
      <span class="engine" data-palette-engine>全书检索</span>
    </div>
  </div>
</div>
