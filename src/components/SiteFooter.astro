---
import { site } from '../config';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand-block">
      <div class="footer-brand">
        <span class="footer-name">{site.title}</span>
        <span class="footer-latin">{site.latin}</span>
      </div>
      <p class="footer-motto">「{site.tagline}」</p>
    </div>

    <nav class="footer-nav" aria-label="页脚导航">
      {site.footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href="/rss.xml" class="footer-rss">
        <Icon name="hash" size={12} class="icon" />
        RSS
      </a>
    </nav>

    <div class="footer-meta">
      <span>© {year} {site.title} · 以 Astro 手作 · 纸与墨皆取自 CSS</span>
      <span>Powered by <a href="https://astro.build" rel="noopener">Astro</a> · 搜索由 <a href="https://pagefind.app" rel="noopener">Pagefind</a> 驱动</span>
    </div>
  </div>
</footer>
