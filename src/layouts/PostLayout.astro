---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import 'katex/dist/katex.min.css';
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/Toc.astro';
import NotesPanel from '../components/NotesPanel.astro';
import Icon from '../components/Icon.astro';
import {
  countWords,
  formatDateZh,
  formatNumber,
  isoDate,
  readingLabel,
  readingTime,
} from '../lib/format';

export interface Props {
  post: CollectionEntry<'posts'>;
  prev?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
}

const { post, prev, next } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);

const words = countWords(post.body ?? '');
const minutes = readingTime(post.body ?? '', data.lang);
const url = new URL(`/posts/${post.id}`, Astro.site);

const description =
  data.description ||
  (post.body ?? '')
    .replace(/```[\s\S]*?```/g, '')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/[#>*`~$_{}[\]()]/g, '')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 120);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  author: { '@type': 'Person', name: data.author ?? '墨痕' },
  keywords: data.tags.join(', '),
  articleSection: data.category,
  timeRequired: `PT${minutes}M`,
  url: url.href,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url.href },
};
---

<BaseLayout
  title={data.title}
  description={description}
  ogType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <Fragment slot="dock">
    <button
      class="dock-btn dock-btn--panel"
      type="button"
      data-drawer-toggle
      aria-label="目录与批注"
      title="目录与批注"
    >
      <Icon name="list" class="icon" size={18} />
      <span class="dock-count" data-notes-badge hidden>0</span>
    </button>
  </Fragment>

  <article
    class="post"
    data-post
    data-slug={post.id}
    data-title={data.title}
    data-url={url.href}
    data-date={isoDate(data.pubDate)}
    data-pagefind-body
  >
    <div class="wrap">
      <header class="post-head">
        <div class="post-kicker">
          <span class="post-cat">{data.category}</span>
          <span class="divider-dot" aria-hidden="true"></span>
          <time datetime={isoDate(data.pubDate)}>{formatDateZh(data.pubDate)}</time>
          {
            data.updatedDate && (
              <>
                <span class="divider-dot" aria-hidden="true" />
                <span>修订于 {formatDateZh(data.updatedDate)}</span>
              </>
            )
          }
        </div>

        <h1 class="post-title">{data.title}</h1>
        {data.subtitle && <p class="post-subtitle">{data.subtitle}</p>}

        <div class="post-meta">
          <span class="meta-item">
            <Icon name="clock" size={13} />
            {readingLabel(post.body ?? '', data.lang)}
          </span>
          <span class="meta-item">
            <Icon name="pen" size={13} />
            共 {formatNumber(words)} 字
          </span>
          <span class="meta-item">
            <Icon name="bookmark" size={13} />
            {data.category}
          </span>
          <button class="meta-item meta-note-btn" type="button" data-notes-focus>
            <Icon name="quote" size={13} />
            批注
            <span class="meta-note-count" data-notes-count-inline>0</span>
          </button>
        </div>
      </header>

      <div class="post-layout">
        <div class="post-main">
          <div class="prose" data-prose id="prose">
            <Content />
          </div>

          <footer class="post-foot">
            <div class="post-foot-rule" aria-hidden="true">
              <span class="rule-dots"><span></span><span></span><span></span></span>
            </div>

            {
              data.tags.length > 0 && (
                <ul class="post-tags post-tags--foot" role="list">
                  {data.tags.map((tag) => (
                    <li>
                      <a class="tag-chip" href={`/tags/${encodeURIComponent(tag)}`}>
                        <span>#{tag}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )
            }

            <nav class="post-footer-nav" aria-label="上一篇与下一篇">
              {
                prev && (
                  <a href={`/posts/${prev.id}`} class="prev">
                    <span class="nav-label">← 前一篇</span>
                    <span class="nav-title">{prev.data.title}</span>
                  </a>
                )
              }
              {
                next && (
                  <a href={`/posts/${next.id}`} class="next">
                    <span class="nav-label">后一篇 →</span>
                    <span class="nav-title">{next.data.title}</span>
                  </a>
                )
              }
            </nav>
          </footer>
        </div>

        <aside class="post-aside" data-drawer-panel>
          <Toc headings={headings} />
          <NotesPanel />
        </aside>
      </div>
    </div>
  </article>

  <div class="drawer-backdrop" data-drawer-backdrop hidden></div>

  <div class="selection-toolbar" data-selection-toolbar hidden role="toolbar" aria-label="选中文字操作">
    <button type="button" data-sel-action="note">
      <Icon name="pen" size={13} />
      批注
    </button>
    <span class="sep" aria-hidden="true"></span>
    <button type="button" data-sel-action="copy">
      <Icon name="copy" size={13} />
      复制
    </button>
    <button type="button" data-sel-action="quote">
      <Icon name="quote" size={13} />
      引用
    </button>
  </div>

  <div class="note-editor" data-note-editor hidden>
    <p class="note-editor-quote" data-note-editor-quote></p>
    <textarea
      data-note-editor-input
      rows="3"
      placeholder="写下此刻的想法……"
      aria-label="批注内容"
    ></textarea>
    <div class="note-editor-actions">
      <button class="btn btn--ghost" type="button" data-note-editor-delete hidden>删除</button>
      <div class="note-editor-main-actions">
        <button class="btn" type="button" data-note-editor-cancel>取消</button>
        <button class="btn btn--primary" type="button" data-note-editor-save>保存</button>
      </div>
    </div>
  </div>
</BaseLayout>
